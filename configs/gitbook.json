{
  "name": "gitbook",
  "description": "GitBook documentation platform. Use for creating, publishing, and managing docs sites — spaces, blocks, Git Sync, customization, AI search, collaboration, and the developer API.",
  "base_url": "https://gitbook.com/docs/",
  "start_urls": [
    "https://gitbook.com/docs/getting-started/readme.md",
    "https://gitbook.com/docs/getting-started/quickstart.md",
    "https://gitbook.com/docs/getting-started/ai-documentation.md",
    "https://gitbook.com/docs/getting-started/import.md",
    "https://gitbook.com/docs/getting-started/git-sync.md",
    "https://gitbook.com/docs/getting-started/git-sync/enabling-github-sync.md",
    "https://gitbook.com/docs/getting-started/git-sync/enabling-gitlab-sync.md",
    "https://gitbook.com/docs/getting-started/git-sync/content-configuration.md",
    "https://gitbook.com/docs/creating-content/formatting.md",
    "https://gitbook.com/docs/creating-content/content-structure.md",
    "https://gitbook.com/docs/creating-content/content-structure/space.md",
    "https://gitbook.com/docs/creating-content/content-structure/page.md",
    "https://gitbook.com/docs/creating-content/content-structure/collection.md",
    "https://gitbook.com/docs/creating-content/blocks.md",
    "https://gitbook.com/docs/creating-content/blocks/code-block.md",
    "https://gitbook.com/docs/creating-content/blocks/hint.md",
    "https://gitbook.com/docs/creating-content/blocks/tabs.md",
    "https://gitbook.com/docs/creating-content/blocks/table.md",
    "https://gitbook.com/docs/creating-content/blocks/expandable.md",
    "https://gitbook.com/docs/creating-content/blocks/stepper.md",
    "https://gitbook.com/docs/creating-content/reusable-content.md",
    "https://gitbook.com/docs/creating-content/variables-and-expressions.md",
    "https://gitbook.com/docs/creating-content/version-control.md",
    "https://gitbook.com/docs/creating-content/ai-coding-assistants-and-skillmd.md",
    "https://gitbook.com/docs/docs-site/site-settings.md",
    "https://gitbook.com/docs/docs-site/customization.md",
    "https://gitbook.com/docs/docs-site/customization/icons-colors-and-themes.md",
    "https://gitbook.com/docs/docs-site/site-structure.md",
    "https://gitbook.com/docs/docs-site/site-structure/site-sections.md",
    "https://gitbook.com/docs/docs-site/site-structure/variants.md",
    "https://gitbook.com/docs/docs-site/publish-a-docs-site.md",
    "https://gitbook.com/docs/docs-site/publish-a-docs-site/public-publishing.md",
    "https://gitbook.com/docs/docs-site/custom-domain.md",
    "https://gitbook.com/docs/docs-site/ai-search.md",
    "https://gitbook.com/docs/docs-site/ai-insights.md",
    "https://gitbook.com/docs/docs-site/embedding.md",
    "https://gitbook.com/docs/docs-site/pdf-export.md",
    "https://gitbook.com/docs/collaboration/share.md",
    "https://gitbook.com/docs/collaboration/member-management.md",
    "https://gitbook.com/docs/collaboration/member-management/permissions-and-inheritance.md",
    "https://gitbook.com/docs/collaboration/member-management/roles.md",
    "https://gitbook.com/docs/collaboration/change-requests.md",
    "https://gitbook.com/docs/collaboration/comments.md",
    "https://gitbook.com/docs/gitbook-agent/readme.md",
    "https://gitbook.com/docs/gitbook-agent/mcp.md",
    "https://gitbook.com/docs/ai-and-search/gitbook-ai.md",
    "https://gitbook.com/docs/ai-and-search/ai-search.md",
    "https://gitbook.com/docs/account-management/plans.md",
    "https://gitbook.com/docs/account-management/billing.md",
    "https://gitbook.com/docs/developers/gitbook-api/reference.md",
    "https://gitbook.com/docs/developers/gitbook-api/authentication.md",
    "https://gitbook.com/docs/developers/integrations/getting-started.md",
    "https://gitbook.com/docs/developers/integrations/blocks.md"
  ],
  "selectors": {
    "main_content": "main, article, .content",
    "title": "h1",
    "code_blocks": "pre code"
  },
  "url_patterns": {
    "include": ["/docs/"],
    "exclude": ["/changelog/", "/policies/", "/help-center/", "/resources/"]
  },
  "categories": {
    "getting_started": ["getting-started", "quickstart", "overview", "import", "readme"],
    "git_sync": ["git-sync", "github-sync", "gitlab-sync", "monorepo", "commits"],
    "content": ["creating-content", "formatting", "content-structure", "blocks", "reusable", "variables", "version-control"],
    "publishing": ["docs-site", "publish", "site-settings", "customization", "custom-domain", "pdf-export", "embedding"],
    "ai": ["ai-search", "ai-insights", "gitbook-ai", "gitbook-agent", "ai-documentation", "ai-and-search"],
    "collaboration": ["collaboration", "share", "member-management", "permissions", "roles", "teams", "change-requests", "comments"],
    "account": ["account-management", "plans", "billing", "sso", "saml"],
    "developers": ["developers", "api", "integrations", "webhooks", "openapi"]
  },
  "rate_limit": 1.0,
  "max_pages": 60
}
